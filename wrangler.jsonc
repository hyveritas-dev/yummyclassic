{
  // Cloudflare Workers: static site (Tailwind CSS built at deploy) + a small worker for /api/* and shared-link previews on /s
  "name": "misty-credit-9cc0",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  // builds assets/tw.css (Tailwind) from index.html on every deploy
  "build": { "command": "npx --yes tailwindcss@3.4.17 -c tailwind.config.js -i tw.in.css -o assets/tw.css --minify" },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s", "/s/*", "/fb*", "/img/*", "/ig", "/igs", "/blog", "/yt", "/yts", "/in", "/k", "/ig/*", "/igs/*", "/blog/*", "/yt/*", "/yts/*", "/in/*", "/k/*"]
  },
  // feedback + result-type counts (SQLite-backed Durable Object, free plan)
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
