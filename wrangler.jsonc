{
  // Cloudflare Workers: static site (no build step) + a small worker for /api/* only
  "name": "misty-credit-9cc0",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
